# FlowSentinel Suite settings. ./setup.sh copies this to .env with a random password.
# Never commit .env.

# PostgreSQL, used by FlowSentinel's server. Letters and digits only.
POSTGRES_USER=flowsentinel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=flowsentinel

# Name of the first FlowSentinel admin; the password is in secrets/flowsentinel_admin_password.
FLOWSENTINEL_ADMIN_USERNAME=admin

# Where capture files are picked up, and the configuration directory (docs/configuration.md).
# Point INBOX_DIR at a bigger disk or a share if you like; the pipeline only reads it.
# INBOX_DIR=./inbox
# CONFIG_DIR=./config

# Ports, bound to 127.0.0.1 only.
FLOWSENTINEL_PORT=8080
DASHBOARD_PORT=8088
DAGSTER_PORT=3000
# KAFKA_PORT=19092

# Behind an HTTPS reverse proxy (see docs/deployment.md):
# FLOWSENTINEL_ALLOWED_HOSTS=flowsentinel.example.com
# FLOWSENTINEL_SECURE_COOKIES=true

# Limits passed to `flowsentinel flows` for each capture part. The defaults are the CLI's
# maximums; lower them on a small machine, for example:
# FLOWLAKE_FLOWSENTINEL_ARGS=--max-packets 200000 --max-duration-seconds 600

# Prebuilt images instead of building from source:
# LAKEHOUSE_IMAGE=flowsentinel-lakehouse:0.2.1
# FLOWSENTINEL_IMAGE=flowsentinel-api:suite
# Build FlowSentinel from a local checkout instead of GitHub:
# FLOWSENTINEL_SOURCE=../../flowsentinel

# RUST_LOG=info
